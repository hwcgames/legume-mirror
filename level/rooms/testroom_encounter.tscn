[sub_resource type="GDScript" id="GDScript_cj8is"]
script/source = "extends Node

func start_battle():
	if %Battlefield.phase != Battlefield.PHASE.IDLE:
		return
	%Enemy1.state = 0
	%Enemy1.hp = %Enemy1.max_hp
	var players = get_tree().get_nodes_in_group(\"party_member\").slice(0, len(%Battlefield.player_landmarks))
	%Battlefield.players.clear()
	for player in players:
		%Battlefield.players.push_back(player)
	%PhantomCamera3D.priority += 2
	await %Battlefield.battle()
	%PhantomCamera3D.priority -= 2

func _on_testroom_player_entered(player: PartyMember) -> void:
	start_battle()
"

