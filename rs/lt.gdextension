[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://rs/target/x86_64-unknown-linux-gnu/debug/liblt.so"
linux.release.x86_64 =   "res://rs/target/x86_64-unknown-linux-gnu/release/liblt.so"
windows.debug.x86_64 =   "res://rs/target/x86_64-pc-windows-gnu/debug/lt.dll"
windows.release.x86_64 = "res://rs/target/x86_64-pc-windows-gnu/release/lt.dll"
