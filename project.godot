; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

resources_spreadsheet_view/array_color_tint=100.0
resources_spreadsheet_view/color_rows=true
resources_spreadsheet_view/array_min_width=128.0
resources_spreadsheet_view/resource_preview_size=32.0
resources_spreadsheet_view/clip_headers=false
resources_spreadsheet_view/dupe_arrays=true
resources_spreadsheet_view/context_menu_on_leftclick=false
resources_spreadsheet_view/fold_docks=true
resources_spreadsheet_view/resource_cell_label_mode=1
resources_spreadsheet_view/freeze_first_column=true
instance_dock/scene_data_file="res://InstanceDockSceneData.txt"
instance_dock/preview_resolution=Vector2i(64, 64)

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Legume Traffick"
run/main_scene="uid://cw0r478jvhrnn"
config/features=PackedStringArray("4.6", "C#")
config/icon="res://icon.svg"

[autoload]

MultiplayerInput="*uid://64bdsrtamugy"
InputLocks="*res://InputLocks.gd"
PlayerManager="*res://player_manager.gd"
Inventory="*res://inventory/inventory.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
Saver="*res://save_file/saver.gd"
MusicMan="*res://music/musicman.gd"
CyclopsAutoload="*uid://4siqre3jhe80"
Storyteller="*res://story/Storyteller.gd"
Fader="*uid://cqcl700i7h12u"
Panku="*res://addons/panku_console/console.tscn"
Chatterbox="*res://story/Chatterbox.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=480

[dotnet]

project/assembly_name="Legume Traffick"

[editor]

movie_writer/ogv/encoding_speed=2
movie_writer/movie_file="/mnt/data/godot/legume-traffick/movie.ogv"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/GodotInk/plugin.cfg", "res://addons/InstanceDock/plugin.cfg", "res://addons/cyclops_level_builder/plugin.cfg", "res://addons/multiplayer_input/plugin.cfg", "res://addons/panku_console/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/resources_spreadsheet_view/plugin.cfg", "res://addons/room_seam_gizmo/plugin.cfg")

